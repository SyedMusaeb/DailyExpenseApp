<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyExpense.Views.CategoryDetailPage">
    <VerticalStackLayout>
        <Grid RowDefinitions="Auto,Auto,*"
              Padding="15">

            <Label Grid.Row="0"
                   x:Name="lblCategoryTitle"
                   FontAttributes="Bold"
                   FontSize="18"
                   Margin="0,0,0,10" />

            <Border Grid.Row="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="#F5F5F5"
                    Padding="10"
                    HeightRequest="45"
                    Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

              

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="◀"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           Padding="10,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPreviousMonth" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Column="1"
                           x:Name="lblSelectedMonth"
                           Text="September 2026"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Label Grid.Column="2"
                           Text="▶"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           Padding="10,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNextMonth" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <CollectionView Grid.Row="2"
                            x:Name="cvItems">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#E0E0E0"
                                BackgroundColor="White"
                                Padding="12"
                                Margin="0,5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding SamanName}"
                                           FontAttributes="Bold"
                                           FontSize="15" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Amount, StringFormat='₹ {0:N0}'}"
                                           FontAttributes="Bold"
                                           FontSize="15" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                    <Label Grid.Column="1"
                                           Text="{Binding WeightDisplay}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="2"
                   x:Name="lblNoData"
                   Text="No expenses found for this month"
                   TextColor="Gray"
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="False" />

        </Grid>
    </VerticalStackLayout>
</ContentView>
