<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyExpense.Views.Admin.AdminPage">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Padding="15"
          RowSpacing="8">

        <!-- TOTALS -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">
            <Border Stroke="#0067EE"
                    BackgroundColor="#EAF2FF"
                    Padding="12,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label x:Name="lblMonthLabel"
                           Text="Month Total"
                           FontSize="12"
                           TextColor="#0067EE" />
                    <Label x:Name="lblTotal"
                           Text="₹ 0"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0067EE" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1"
                    Stroke="#D32F2F"
                    BackgroundColor="#FDECEC"
                    Padding="12,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Deleted Entries"
                           FontSize="12"
                           TextColor="#D32F2F" />
                    <Label x:Name="lblDeletedCount"
                           Text="0"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#D32F2F" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- USER FILTER -->
        <Border Grid.Row="1"
                Stroke="#A9A9A9"
                BackgroundColor="White"
                Padding="10,0"
                HeightRequest="45">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Picker x:Name="pickerUser"
                    Title="Select User"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    SelectedIndexChanged="OnFilterChanged" />
        </Border>

        <!-- MONTH NAVIGATOR -->
        <Border Grid.Row="2"
                Stroke="#E0E0E0"
                BackgroundColor="#F5F5F5"
                Padding="10"
                HeightRequest="45">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Text="◀"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Padding="10,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviousMonth" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1"
                       x:Name="lblSelectedMonth"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="▶"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Padding="10,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextMonth" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- SHOW DELETED SWITCH -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto">
            <Label Text="Deleted data bhi dikhao"
                   VerticalOptions="Center" />
            <Switch Grid.Column="1"
                    x:Name="swDeleted"
                    IsToggled="True"
                    Toggled="OnSwitchToggled" />
        </Grid>

        <!-- LIST -->
        <CollectionView Grid.Row="4"
                        x:Name="cvAdmin">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E0E0E0"
                            BackgroundColor="{Binding CardColor}"
                            Padding="12"
                            Margin="0,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding SamanName}"
                                       FontAttributes="Bold"
                                       FontSize="15" />
                                <Label Grid.Column="1"
                                       Text="{Binding Amount, StringFormat='₹ {0:N0}'}"
                                       FontAttributes="Bold"
                                       FontSize="15" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding CategoryName}"
                                       FontSize="12"
                                       TextColor="#0067EE" />
                                <Label Grid.Column="1"
                                       Text="{Binding WeightDisplay}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding UserName, StringFormat='By: {0}'}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Label Grid.Column="1"
                                       Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </Grid>
                            <Label Text="{Binding StatusText}"
                                   FontSize="12"
                                   TextColor="#D32F2F"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
