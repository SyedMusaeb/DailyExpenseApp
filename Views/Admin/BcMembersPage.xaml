<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:DailyExpense.Views.Loader"
             x:Class="DailyExpense.Views.Admin.BcMembersPage">
    <Grid>
        <Grid RowDefinitions="Auto,Auto,*"
          Padding="15"
          RowSpacing="10">

        <Label Text="BC Members"
               FontSize="18"
               FontAttributes="Bold" />

        <!-- ADD MEMBER FORM -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="8">
            <Label Text="Member Name"
                   FontSize="13"
                   TextColor="Gray" />
            <Border x:Name="borderName"
                    Stroke="#A9A9A9"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="48">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry x:Name="txtName"
                       Placeholder="Enter member name"
                       MaxLength="30"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Border>

            <Button x:Name="btnAdd"
                    Text="Add Member"
                        BackgroundColor="#0067EE"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="48"
                    Clicked="OnAddClicked" />
        </VerticalStackLayout>

        <!-- MEMBER LIST -->
        <CollectionView Grid.Row="2"
                        x:Name="cvMembers">
            <CollectionView.EmptyView>
                <Label Text="Abhi koi member nahi hai"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E0E0E0"
                            BackgroundColor="{Binding RowColor}"
                            Padding="14"
                            Margin="0,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMemberTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="40,*,Auto">
                            <Label Text="{Binding Order}"
                                   TextColor="Gray"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding StatusText}"
                                   TextColor="#D32F2F"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
        <v:LoadingOverlay x:Name="loader" />
    </Grid>
</ContentView>
