<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyExpense.Views.Login"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             Spacing="8"
                             Padding="10">
            <!--<Image Source="home.png"
                   HeightRequest="20"
                   WidthRequest="20"
                   HorizontalOptions="Start">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Home_Clicked" />
                </Image.GestureRecognizers>
            </Image>-->

            <Image Source="house.png"
                   HeightRequest="100"
                   WidthRequest="100" />
            <Label Text="Daily Expense!"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   FontSize="24"
                   FontAttributes="Bold" />
            <!--<Entry Placeholder="Username"
                   PlaceholderColor="Grey"
                   x:Name="txtemail"
                   FontSize="14"
                   TextColor="black"
                   FontAttributes="Bold" />-->
            <Border x:Name="borderusername" 
                Stroke="#A9A9A9"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="45"
                    Margin="0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="30,*">
                    <Image Grid.Column="0"
                           Source="user.png"
                           HeightRequest="20"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Mobile / Username"
                           Margin="0,0,0,0"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" 
                           x:Name="txtphoneusername"
                           />
                </Grid>
            </Border>
            <!--<Entry Placeholder="Password"
                   PlaceholderColor="Grey"
                   x:Name="txtpassword"
                   IsPassword="True"
                   FontSize="14"
                   TextColor="black"
                   FontAttributes="Bold" />-->

            <Border x:Name="borderpassword"
                Stroke="#A9A9A9"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="45"
                    Margin="0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="30,*">
                    <Image Grid.Column="0"
                           Source="padlock.png"
                           HeightRequest="20"
                           VerticalOptions="Center" />

                    <Entry Grid.Column="1"
                           Placeholder="Password"
                           Margin="0,0,0,0"
                           IsPassword="True"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           x:Name="txtpassword" />

                    <ImageButton Grid.Column="2"
                                 x:Name="btnEye"
                                 Source="closedeyes.png"
                                 Margin="11"
                                 BackgroundColor="Transparent"
                                 Clicked="OnEyeClicked"
                                 HorizontalOptions="End" />
                </Grid>
            </Border>
            <Label Text="Forgot Password"
                   TextColor="Blue"
                   FontSize="12"
                   TextDecorations="Underline"
                   HorizontalOptions="End"
                   Margin="0,0,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="forgot_Clicked" />
                </Label.GestureRecognizers>

            </Label>
            <Button Margin="0,10,0,0"
                    Text="Submit"
                    BackgroundColor="#0067EE"
                    x:Name="login"
                    Clicked="login_Clicked" />
            <Label Text="New Registration?"
                   TextColor="Blue"
                   FontSize="12"
                   TextDecorations="Underline"
                   HorizontalOptions="Center"
                   Margin="0,0,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="register_Clicked" />
                </Label.GestureRecognizers>

            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>