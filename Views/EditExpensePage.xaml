            <Label Text="Category"
                   Margin="0,0,0,0" />

            <Border Stroke="#A9A9A9"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="45">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="30,*,20">

                    <Image Grid.Column="0"
                           Source="dropdowncategary.png"
                           HeightRequest="20"
                           VerticalOptions="Center" />

                    <Picker Grid.Column="1"
                            x:Name="pickerCategory"
                            TitleColor="Gray"
                            BackgroundColor="Transparent">
                    </Picker>

                </Grid>
            </Border>

            <Label Text="Saman Ka Name"
                   Margin="0,0,0,1" />

            <Border Stroke="#A9A9A9"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="45"
                    Margin="0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="30,*">
                    <Image Grid.Column="0"
                           Source="samankaname.png"
                           HeightRequest="20"
                           VerticalOptions="Center" />

                    <Entry Grid.Column="1"
                           Placeholder="Enter Your Saman Name"
                           Margin="0,0,0,0"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           x:Name="txtsamanname" />
                </Grid>
            </Border>

            <Label Text="Saman Ka Weight"
                   Margin="0,0,0,1" />

            <Border Stroke="#A9A9A9"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="45"
                    Margin="0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="30,*">
                    <Image Grid.Column="0"
                           Source="waight.png"
                           HeightRequest="20"
                           VerticalOptions="Center" />

                    <Entry Grid.Column="1"
                           x:Name="txtsamanweight"
                           Placeholder="Weight"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="Amount"
                   Margin="0,0,0,1" />

            <Border Stroke="#A9A9A9"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="45"
                    Margin="0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="30,*">
                    <Image Grid.Column="0"
                           Source="rupessign.png"
                           HeightRequest="20"
                           VerticalOptions="Center" />

                    <Entry Grid.Column="1"
                           Placeholder="Enter Your Amount"
                           Margin="0,0,0,0"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           x:Name="txtamount"
                           Keyboard="Numeric"
                           MaxLength="10" />
                </Grid>
            </Border>

            <Label Text="Date"
                   Margin="0,0,0,1" />

            <Border Stroke="#A9A9A9"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="10,0"
                    HeightRequest="45"
                    Margin="0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="30,*">
                    <Image Grid.Column="0"
                           Source="datepicker.png"
                           HeightRequest="20"
                           VerticalOptions="Center" />

                    <DatePicker Grid.Column="1"
                                x:Name="dpDate"
                                Format="dd/MM/yyyy"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Margin="0,10,0,0"
                    Text="Update"
                    BackgroundColor="#0067EE"
                    x:Name="update"
                    Clicked="OnUpdateClicked" />
            <Button Margin="0,10,0,0"
                    Text="Delete"
                    BackgroundColor="Red"
                    x:Name="delete"
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
